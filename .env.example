# Loyalty Card System — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# =============================================================================
# SUPABASE (PostgreSQL, Auth, Storage, Realtime, RLS)
# =============================================================================

# Full Supabase project URL, e.g. https://xyzabc.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key (starts with "eyJ...")
# Used by the client-side Supabase client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (starts with "eyJ...", different from anon key)
# Used ONLY on the server side. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# APPLICATION BRANDING (overrides database settings when set)
# Used during development / CI only. In production these come from the DB.
# =============================================================================

# Application name shown in browser tabs, emails, etc.
# Defaults to [SYSTEM NAME] if not set.
NEXT_PUBLIC_APP_NAME=

# =============================================================================
# AI / LLM (optional — Phase 8)
# =============================================================================

# OpenAI-compatible API base URL (e.g. https://api.openai.com/v1)
AI_API_BASE_URL=

# AI API key
AI_API_KEY=

# Default model for AI requests
AI_DEFAULT_MODEL=

# =============================================================================
# WHATSAPP (optional — Phase 7)
# =============================================================================

# WhatsApp Business API token / credentials (if using Meta Cloud API)
WHATSAPP_TOKEN=

# WhatsApp Business phone number ID
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business verified business account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=

# =============================================================================
# PAYMENTS (optional — Phase 9)
# =============================================================================

# Payment provider configuration is stored in the database.
# No environment variables required for the abstraction layer itself.
# Individual provider keys go here when configured.

# =============================================================================
# APPLE WALLET / GOOGLE WALLET (optional — Phase 3)
# =============================================================================

# Wallet certificate and key files are stored in Supabase Storage.
# No environment variables required for the abstraction layer itself.

# =============================================================================
# RATE LIMITING / SECURITY (optional)
# =============================================================================

# Session secret for cookie signing (Next.js will generate one if omitted)
# If set, use a random 32+ character string.
SESSION_SECRET=
